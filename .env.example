# ============================================================
# Store-AI-Agent — Required Environment Variables
# ============================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to git (it's already in .gitignore).
# On Render / Railway / Fly.io, set these in the platform's
# "Environment Variables" / "Variables" settings panel instead.
# ============================================================


# ---- Appwrite (get from your Appwrite Console) --------------
# Project Settings → API Endpoint
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Project Settings → Project ID
APPWRITE_PROJECT_ID=your_project_id_here

# API Keys → Create Key (scope: databases.read, databases.write, storage.read, storage.write)
APPWRITE_API_KEY=your_api_key_here

# Databases → your database → Database ID (the string shown next to the DB name)
APPWRITE_DATABASE_ID=your_database_id_here

# Storage → Buckets → widget_icons → Bucket ID
APPWRITE_WIDGET_ICONS_BUCKET=widget_icons


# ---- Shopify App (get from Shopify Partners Dashboard) ------
# App setup → Client ID
SHOPIFY_API_KEY=your_shopify_client_id_here

# App setup → Client secret
SHOPIFY_API_SECRET=your_shopify_client_secret_here

# Permissions the app requests (do not change unless you know why)
SHOPIFY_SCOPES=read_products,read_orders,write_orders,read_customers,write_script_tags,read_script_tags,write_themes,read_themes,read_order_edits,write_order_edits


# ---- App Server -----------------------------------------
# Public HTTPS URL where this server is deployed.
# Must match what you registered as the App URL in Shopify Partners.
# Local dev: use ngrok e.g. https://abc123.ngrok-free.app
APP_URL=https://your-app-url.onrender.com

# Secret key for session cookies — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-random-secret


# ---- LLM / AI Provider ----------------------------------
# Primary model for chat reply generation
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: Groq (fast, cheap)
# GROQ_API_KEY=your_groq_api_key_here

# Optional: Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here


# ---- Email (for password reset) -------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=your@gmail.com
